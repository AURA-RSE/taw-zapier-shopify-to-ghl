# Configuration reference for the Shopify -> GHL Zap.
# Credentials are stored in Zapier app connections, not in this repo.
# Never commit real values.

# Shopify
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxx

# GoHighLevel / LeadConnector
GHL_LOCATION_ID=xxxxxxxxxxxxxxxx
GHL_API_KEY=xxxxxxxxxxxxxxxx
GHL_WORKFLOW_ID=xxxxxxxxxxxxxxxx
# Stand-in used while no GHL account is available (steps 9-10 POST here)
GHL_STANDIN_WEBHOOK_URL=https://webhook.site/your-unique-id

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Google Sheets
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxx
GOOGLE_SHEET_ORDERS_TAB=Orders
GOOGLE_SHEET_ERRORS_TAB=Errors

# Alerts
ALERT_EMAIL=you@example.com

# Business rules
HIGH_VALUE_THRESHOLD=100
DEFAULT_CURRENCY=USD
