              "skus": "{{=gives[\"386104489\"][\"lineItems[]sku\"]}}"
            },
            "code": "// Step 2: normalise Shopify order data\nconst email = (inputData.email || '').trim().toLowerCase();\nconst phone = (inputData.phone || '').replace(/[^\\d+]/g, '');\nconst total = parseFloat(inputData.total || '0') || 0;\nconst skus = (inputData.skus || '').split(',').map(s => s.trim()).filter(Boolean);\nconst catMap = {SKIN: 'skincare', APP: 'apparel', ACC: 'accessories'};\nconst cats = [...new Set(skus.map(s => catMap[s.split('-')[0].toUpperCase()]).filter(Boolean))];\nconst products = (inputData.titles || '').split(',').map(s => s.trim()).filter(Boolean).join(', ');\nreturn {email: email, phone: phone, has_email: email.includes('@'), has_phone: phone.length > 6, total: total.toFixed(2), currency: inputData.currency || 'USD', order_id: inputData.order_id, order_number: inputData.order_number, first_name: inputData.first_name || 'there', last_name: inputData.last_name || '', products: products, skus: skus.join(', '), category_tags: cats.map(c => 'cat-' + c).join(','), is_high_value: total >= 100};"
          },
